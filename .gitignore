# Autoresearch runtime stores contain copied media and rebuildable SQLite/Zvec data.
/autoresearch/**/baseline-data/
/autoresearch/**/candidate-data/
/autoresearch/**/final-data/
/autoresearch/**/cache/
/autoresearch/**/baseline/
/autoresearch/**/candidate/
/autoresearch/**/final/
/autoresearch/**/candidate-pool-ablation-*/
/autoresearch/**/candidate-pool-n*-current.json
/autoresearch/**/ablation-jina-video-*/v5-*/
/autoresearch/**/dev-current.json
/autoresearch/**/dev-baseline-current.json
/autoresearch/**/locked-inputs/
/autoresearch/**/performance/
/autoresearch/debug-*/

# Audit receipts written by the protect-mcp tooling, not by this project. It writes them
# relative to the working directory it is invoked from, so they appear at the repo root and
# under src/ alike -- the latter would otherwise land inside the wheel's package root. The
# patterns are unanchored for that reason.
receipts/
review-receipts/

# Celery beat writes its schedule database to the working directory it is started from,
# which for this deployment is the repo root. It is runtime state, not source.
celerybeat-schedule

# Agent scratch: implementation-plan workspaces (ledgers, task briefs, reports, review diffs).
# The subagent-driven-development skill assumes this directory is ignored; it holds working
# notes for one plan and nothing another checkout needs.
.superpowers/
