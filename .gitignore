.venv/
# Isolated environments created by the CI installability and wheel checks.
/.install-venv/
/.wheel-venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/
*.log
.env
.env.local
# Local model checkout used by the WeMM deployment guide.
/WeMM-Embedding-2B/
.mindbridge/
# Benchmark corpora, results, and run configurations. `.benchmarks/configs/` holds the files
# passed to `mindbridge-bench eval --config`, which may carry endpoint credentials, so keep
# this rule covering the whole directory. The committed template lives at
# docs/examples/eval.example.yaml instead.
.benchmarks/
# Default outputs of the credentialed model-quality CLIs.
/model-quality.json
/workflow-quality.json

# Autoresearch workspaces and generated artifacts are local-only.
/autoresearch/

# Private research notes and evidence stay on this machine.
/docs/research/
/research/

# Audit receipts written by the protect-mcp tooling, not by this project. It writes them
# relative to the working directory it is invoked from, so they appear at the repo root and
# under src/ alike -- the latter would otherwise land inside the wheel's package root. The
# patterns are unanchored for that reason.
receipts/
review-receipts/

# Agent scratch: implementation-plan workspaces (ledgers, task briefs, reports, review diffs).
# The subagent-driven-development skill assumes this directory is ignored; it holds working
# notes for one plan and nothing another checkout needs.
.superpowers/
# Keep completed agent plans and superseded specifications out of product documentation.
/docs/superpowers/

# Agent-created linked worktrees are local-only.
/.claude/worktrees/

# Codex CLI reads its MCP server list from here; the entries are per-contributor tooling.
/.codex/
