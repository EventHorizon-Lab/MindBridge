              "type": "integer"
            },
            "device_id": {
              "maxLength": 255,
              "minLength": 1,
              "title": "Device Id",
              "type": "string"
            },
            "ended_at": {
              "format": "date-time",
              "title": "Ended At",
              "type": "string"
            },
            "idempotency_key": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Idempotency Key"
            },
            "identity_observations": {
              "default": [],
              "items": {
                "$ref": "#/$defs/IdentityObservationInput"
