# Copy to .env and fill in; .env is gitignored and never committed.
# Run commands with: uv run --env-file .env <command>

# Shared fallback for outbound OpenAI-compatible generation/combined-model operations.
# Memory embeds with Jina and analyzes speech with FunASR locally unless explicit backends are used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional combined OpenAIHTTP/ModelBackend embedding settings. The default Jina adapter ignores
# this section and derives its own immutable space_id.
# MINDBRIDGE_EMBEDDING_API_KEY=embedding-provider-key
# MINDBRIDGE_EMBEDDING_BASE_URL=https://embedding.example.com/v1
MINDBRIDGE_EMBEDDING_MODEL=text-embedding-3-small
# MINDBRIDGE_EMBEDDING_SPACE=provider-model-recipe-v1
MINDBRIDGE_EMBEDDING_DIMENSION=1536
MINDBRIDGE_EMBEDDING_MODALITIES=text

# Grounded generation endpoint and declared capabilities.
# MINDBRIDGE_GENERATION_API_KEY=generation-provider-key
# MINDBRIDGE_GENERATION_BASE_URL=https://generation.example.com/v1
MINDBRIDGE_GENERATION_MODEL=gpt-5-mini
MINDBRIDGE_GENERATION_MODALITIES=text

# Audio transcription settings for an explicit combined OpenAIHTTP/ModelBackend.
# MINDBRIDGE_TRANSCRIPTION_API_KEY=transcription-provider-key
# MINDBRIDGE_TRANSCRIPTION_BASE_URL=https://speech.example.com/v1
MINDBRIDGE_TRANSCRIPTION_MODEL=whisper-1
# Change this when the ASR model or preprocessing recipe changes; use a new data_dir.
# MINDBRIDGE_TRANSCRIPTION_SPACE=provider-model-asr-recipe-v1
MINDBRIDGE_TRANSCRIPTION_MODALITIES=audio

# Media policy. Remote URL ingestion is disabled while the host list is empty.
MINDBRIDGE_ALLOWED_URL_HOSTS=
MINDBRIDGE_MEDIA_TRANSPORT=data
MINDBRIDGE_TIMEOUT_SECONDS=120

# Optional inbound bearer key for the REST server.
MINDBRIDGE_API_KEY=
